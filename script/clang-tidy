#!/usr/bin/env python3
"""Run clang-tidy over this component with ESPHome's .clang-tidy rules.

ESPHome's own script/clang-tidy works against the ESPHome source tree, which is
also the tree it compiles. An external component is different: `esphome compile`
copies components/ into .esphome/build/<name>/src/esphome/components/, and the
compile_commands.json that ESP-IDF's CMake writes therefore names those copies.

Analysing the copies directly is the only thing that works -- an include of
"esphome/components/..." from the generated esphome.h resolves relative to the
including file, so no -I can redirect it at the working tree -- but the copies
are not what anyone edits. So this script syncs the working tree into the build
tree first, which makes the two byte-identical, analyses the copies, and then
translates every path it reports (and every fix it applies) back to the working
tree. Byte-identical is what makes that safe: a fix's offsets mean the same
thing in both files.

The generated main.cpp is analysed too. Without it the protocol class templates
go unchecked: a member body like Vista20P::handle_UART_events_impl is only
instantiated where the template is used, and nothing in components/ uses it.

Usage:
  script/clang-tidy                 # check everything
  script/clang-tidy --fix           # apply fixes clang-tidy is confident about
  script/clang-tidy path/to/a.cpp   # check specific files
"""

from __future__ import annotations

import argparse
from concurrent.futures import ThreadPoolExecutor
import functools
import json
import multiprocessing
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
COMPONENT = "vista_alarm_panel"
WORK = ROOT / "components" / COMPONENT

# GCC-only flags the ESP-IDF xtensa build emits that clang rejects outright.
# Same list ESPHome's script/clang-tidy drops.
OMIT_FLAGS = frozenset(
    (
        "-free",
        "-fipa-pta",
        "-fstrict-volatile-bitfields",
        "-mlongcalls",
        "-mtext-section-literals",
        "-mdisable-hardware-atomics",
        "-mfix-esp32-psram-cache-issue",
        "-mfix-esp32-psram-cache-strategy=memw",
        "-fno-tree-switch-conversion",
        "-freorder-blocks",
        "-fno-jump-tables",
        "-fno-shrink-wrap",
        "-mno-target-align",
    )
)


@functools.cache
def toolchain_includes(cxx: str) -> tuple[str, ...]:
    """Ask the real cross-compiler where its headers live.

    We compile with -nostdinc, so clang finds nothing on its own: the xtensa
    GCC's libstdc++ and newlib directories have to be handed to it explicitly.
    """
    proc = subprocess.run(
        [cxx, "-E", "-x", "c++", "-", "-v"],
        input="",
        capture_output=True,
        encoding="utf-8",
        check=False,
    )
    dirs, collecting = [], False
    for line in proc.stderr.splitlines():
        if line.startswith("#include <...> search starts here:"):
            collecting = True
        elif line.startswith("End of search list"):
            break
        elif collecting:
            path = Path(line.strip())
            if path.is_dir():
                dirs.append(str(path.resolve()))
    if not dirs:
        sys.exit(f"Could not read the include search path from {cxx}")
    return tuple(dirs)


@functools.cache
def char_signedness_flag(cxx: str) -> str:
    """Ask the cross-compiler whether plain char is signed on this target.

    The x86 model we borrow to parse with has signed char. xtensa-esp32-elf
    does not: it defines __CHAR_UNSIGNED__. Left unstated, every comparison of
    a char against a byte >= 0x80 -- which a protocol decoder is full of -- is
    reported as tautologically false, pointing at correct code and calling it
    dead. Derive it rather than hardcode it, so this stays right if the
    component is ever built for a target whose default differs.
    """
    proc = subprocess.run(
        [cxx, "-dM", "-E", "-x", "c++", "-"],
        input="",
        capture_output=True,
        encoding="utf-8",
        check=False,
    )
    unsigned = any(
        line.startswith("#define __CHAR_UNSIGNED__")
        for line in proc.stdout.splitlines()
    )
    return "-funsigned-char" if unsigned else "-fsigned-char"


@functools.cache
def clang_options(cxx: str) -> tuple[str, ...]:
    """Flags that let clang parse an xtensa ESP-IDF translation unit.

    clang has an Xtensa frontend but not the esp32 core configuration the IDF
    headers need, so ESPHome analyses xtensa targets as 32-bit x86 that claims
    to be Xtensa. This mirrors that, since the point is to reproduce ESPHome's
    diagnostics rather than to invent our own setup.
    """
    opts = [
        "-m32",
        "-U__i386__",
        "-U__x86_64__",
        "-D__XTENSA__",
        "-D__XTENSA_EL__",
        "-D_LIBC",
        # plain char signedness, read back from the target compiler
        char_signedness_flag(cxx),
        # host headers must not leak in; toolchain_includes() replaces them
        "-nostdinc",
        "-nostdinc++",
        # let code condition on the analyser
        "-DCLANG_TIDY",
        # fixes __once_callable in some libstdc++ headers under esp-idf
        "-D_GLIBCXX_HAVE_TLS",
        # attribute cannot be applied to type; keeps deprecation output stable
        "-Ddeprecated(x)=",
        # the real build is gnu++20; the native IDF build defaults to gnu++2b,
        # and analysing as C++23 flags code that does not compile under gnu++20
        "-std=gnu++20",
    ]
    opts.extend(f"-isystem{d}" for d in toolchain_includes(cxx))
    return tuple(opts)


def expand_response_files(args: list[str], base: Path) -> list[str]:
    """Inline @file arguments.

    ESP-IDF hands the toolchain flags to the compiler through a response file
    (build/toolchain/cxxflags) rather than on the command line, so the GCC-only
    flags are invisible to a filter that only looks at the command string.
    """
    out = []
    for arg in args:
        if not arg.startswith("@"):
            out.append(arg)
            continue
        path = Path(arg[1:])
        if not path.is_absolute():
            path = base / path
        if not path.is_file():
            out.append(arg)
            continue
        out.extend(
            expand_response_files(shlex.split(path.read_text(encoding="utf-8")), base)
        )
    return out


def find_compile_db() -> Path:
    candidates = sorted(
        (ROOT / ".esphome" / "build").glob("*/build/compile_commands.json"),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    if not candidates:
        sys.exit(
            "No compile_commands.json found under .esphome/build/.\n"
            "Run `esphome compile vista-ecp-idf.yaml` once to generate it."
        )
    return candidates[0]


def staged_dir(db_path: Path) -> Path:
    return db_path.parent.parent / "src" / "esphome" / "components" / COMPONENT


def sync_sources(staged: Path) -> int:
    """Copy the working tree over the build tree's copy of this component."""
    n = 0
    for f in WORK.rglob("*"):
        if f.suffix in (".h", ".cpp"):
            target = staged / f.relative_to(WORK)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(f, target)
            n += 1
    return n


def build_db(db_path: Path, staged: Path) -> tuple[Path, list[str]]:
    """Write a clang-parseable database covering this component and main.cpp."""
    entries, out, files = json.loads(db_path.read_text(encoding="utf-8")), [], []
    for entry in entries:
        path = entry["file"]
        if not (path.startswith(str(staged)) or path.endswith("/src/main.cpp")):
            continue
        command = entry.get("command") or shlex.join(entry["arguments"])
        parts = expand_response_files(shlex.split(command), Path(entry["directory"]))
        cxx, rest = parts[0], parts[1:]
        kept = [
            a
            for a in rest
            if a not in OMIT_FLAGS
            and not a.startswith("-Werror")
            and not a.startswith("-std=")
            and not a.startswith("-fdiagnostics-color")
        ]
        entry = dict(entry)
        entry.pop("arguments", None)
        entry["command"] = shlex.join(["clang++", *clang_options(cxx), *kept])
        out.append(entry)
        files.append(path)

    if not out:
        sys.exit(f"{db_path} has no entries for {COMPONENT} or main.cpp.")

    dest = ROOT / ".esphome" / "clang-tidy"
    dest.mkdir(parents=True, exist_ok=True)
    (dest / "compile_commands.json").write_text(
        json.dumps(out, indent=2), encoding="utf-8"
    )
    return dest, files


def to_working_tree(text: str, staged: Path) -> str:
    """Rewrite build-tree paths in clang-tidy output to the files people edit."""
    return text.replace(f"{staged}/", f"{WORK}/")


def apply_fixes(fix_dir: Path, staged: Path, clang_apply: str) -> None:
    """Point exported fixes at the working tree, then apply them.

    clang-apply-replacements merges the fixes from every translation unit
    before touching anything, which is what makes a rename in a shared header
    safe: applying per-file with --fix renames the declaration for one
    translation unit and leaves the others referring to a name that no longer
    exists.
    """
    kept = 0
    for yaml_file in fix_dir.glob("*.yaml"):
        text = yaml_file.read_text(encoding="utf-8")
        # Only replacements inside this component may be applied; main.cpp and
        # the esphome core are not ours to rewrite.
        text = to_working_tree(text, staged)
        lines, out, drop = text.split("\n"), [], False
        for line in lines:
            m = re.match(r"^(\s*)-?\s*FilePath:\s+'?([^'\s]+)'?\s*$", line)
            if m:
                drop = not m.group(2).startswith(str(WORK))
            if not drop:
                out.append(line)
            elif re.match(r"^\s*-\s", line) and "FilePath" not in line:
                drop = False
                out.append(line)
        yaml_file.write_text("\n".join(out), encoding="utf-8")
        kept += 1
    if kept:
        subprocess.run(
            [clang_apply, "--format", "--style=file", str(fix_dir)], check=False
        )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("files", nargs="*", help="limit the run to these sources")
    parser.add_argument("--fix", action="store_true", help="apply fixes in place")
    parser.add_argument(
        "-j",
        "--jobs",
        type=int,
        default=multiprocessing.cpu_count(),
        help="parallel clang-tidy processes",
    )
    parser.add_argument(
        "--checks", help="override the check list (passed straight to clang-tidy)"
    )
    parser.add_argument(
        "--clang-tidy",
        default="clang-tidy",
        help="clang-tidy executable (ESPHome pins 22.1.8)",
    )
    args = parser.parse_args()

    if shutil.which(args.clang_tidy) is None:
        sys.exit(
            f"{args.clang_tidy} not found. ESPHome pins clang-tidy 22.1.8; install it with:\n"
            "  pip install clang-tidy==22.1.8\n"
            "or point at another build with --clang-tidy /path/to/clang-tidy"
        )

    db_path = find_compile_db()
    staged = staged_dir(db_path)
    synced = sync_sources(staged)
    db_dir, files = build_db(db_path, staged)

    if args.files:
        wanted = set()
        for f in args.files:
            resolved = Path(f).resolve()
            try:
                wanted.add(str(staged / resolved.relative_to(WORK)))
            except ValueError:
                wanted.add(str(resolved))
        files = [f for f in files if f in wanted]
        if not files:
            sys.exit("None of those files are in the compilation database.")

    base = [
        args.clang_tidy,
        "-p",
        str(db_dir),
        f"--header-filter={staged}/.*",
        "--quiet",
    ]
    if args.checks:
        base.append(f"--checks={args.checks}")
    if sys.stdout.isatty() and not args.fix:
        base.append("--use-color")

    print(
        f"Synced {synced} files into the build tree; "
        f"checking {len(files)} translation units (-j{args.jobs})\n",
        flush=True,
    )

    fix_dir = Path(tempfile.mkdtemp(prefix="clang-tidy-fixes-")) if args.fix else None
    failed = []

    def run(index_path: tuple[int, str]) -> None:
        index, path = index_path
        cmd = list(base)
        if fix_dir is not None:
            cmd.append(f"--export-fixes={fix_dir / f'{index}.yaml'}")
        proc = subprocess.run(
            [*cmd, path], capture_output=True, encoding="utf-8", check=False
        )
        text = to_working_tree((proc.stdout or "") + (proc.stderr or ""), staged)
        # Findings outside this component are not ours to act on. main.cpp is
        # analysed only so the class templates get instantiated, and it is
        # generated code full of diagnostics nobody can act on, so keep only
        # the blocks anchored to a file in components/.
        blocks, current, keep = [], [], False
        for line in text.splitlines():
            m = re.match(r"^(/\S+):\d+:\d+: (?:error|warning|note):", line)
            if m:
                if current and keep:
                    blocks.append("\n".join(current))
                current, keep = [line], m.group(1).startswith(str(WORK))
            elif current:
                current.append(line)
        if current and keep:
            blocks.append("\n".join(current))
        if blocks:
            print(f"=== {Path(path).name}\n" + "\n".join(blocks) + "\n", flush=True)
            # Exit status tracks findings in components/ only. A non-zero
            # return from clang-tidy on its own would mean main.cpp, which is
            # generated and always has some.
            failed.append(path)

    with ThreadPoolExecutor(max_workers=args.jobs) as pool:
        list(pool.map(run, enumerate(files)))

    if fix_dir is not None:
        apply_fixes(
            fix_dir,
            staged,
            args.clang_tidy.replace("clang-tidy", "clang-apply-replacements"),
        )
        shutil.rmtree(fix_dir, ignore_errors=True)
        print("Applied fixes to the working tree; re-run to check convergence.")
        return 0

    if failed:
        print(f"clang-tidy reported problems in {len(failed)} of {len(files)} files")
        return 1
    print(f"clang-tidy clean across {len(files)} translation units")
    return 0


if __name__ == "__main__":
    sys.exit(main())
